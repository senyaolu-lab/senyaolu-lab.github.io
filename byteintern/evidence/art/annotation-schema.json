{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:portfolio:art:annotation:1.0",
 "title":"Manual art annotation / 人工资产验收与媒介标注",
 "description":"Schema for exported records. Empty aesthetic scores remain null. No aggregate aesthetic or consistency score is produced.",
 "oneOf":[{"$ref":"#/$defs/assetAcceptance"},{"$ref":"#/$defs/aestheticAnnotation"}],
 "$defs":{
  "checks":{"type":"object","minProperties":7,"maxProperties":7,"propertyNames":{"enum":["silhouette","face","palette","bag","lantern","joints","surface"]},"additionalProperties":{"enum":["unreviewed","consistent","review","occluded"]}},
  "scores":{"type":"object","minProperties":5,"maxProperties":5,"propertyNames":{"enum":["composition","medium","light","structure","semantics"]},"additionalProperties":{"anyOf":[{"type":"integer","minimum":1,"maximum":5},{"type":"null"}]}},
  "assetAcceptance":{"type":"object","required":["schemaVersion","kind","exportedAt","asset","assetCode","bibleVersion","reviewer","notes","checks","completion","method","scope"],"additionalProperties":false,"properties":{"schemaVersion":{"const":"1.0"},"kind":{"const":"asset_acceptance"},"exportedAt":{"type":"string","format":"date-time"},"asset":{"enum":["lantern-character.png","lantern-scene.png","lantern-stress.png"]},"assetCode":{"type":"string"},"bibleVersion":{"const":"1.0"},"reviewer":{"type":"string"},"notes":{"type":"string"},"checks":{"$ref":"#/$defs/checks"},"completion":{"enum":["draft","reviewed"],"description":"reviewed means all attributes were observed or marked occluded; it does not mean all passed."},"method":{"type":"string"},"scope":{"type":"string"}}},
  "variantAnnotation":{"type":"object","required":["variant","asset","targetMedium","reviewer","scores","notes"],"additionalProperties":false,"properties":{"variant":{"enum":["photo","gouache","clay"]},"asset":{"enum":["rain-market.png","rain-gouache.png","rain-clay.png"]},"targetMedium":{"type":"string"},"reviewer":{"type":"string"},"scores":{"$ref":"#/$defs/scores"},"notes":{"type":"string"}}},
  "aestheticAnnotation":{"type":"object","required":["schemaVersion","kind","exportedAt","comparisonReference","alignment","annotations","method","scope"],"additionalProperties":false,"properties":{"schemaVersion":{"const":"1.0"},"kind":{"const":"aesthetic_annotation"},"exportedAt":{"type":"string","format":"date-time"},"comparisonReference":{"const":"rain-market.png"},"alignment":{"type":"string"},"annotations":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/variantAnnotation"}},"method":{"type":"string"},"scope":{"type":"string"}}}
 }
}
